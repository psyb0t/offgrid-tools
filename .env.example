# Optional launcher environment overrides. Export them before running strata/run.sh.
# The launcher does not source .env as shell code.
# CLI options override these values; saved preset settings are used otherwise.
# STRATA_MODEL=qwen-iq2-xs
# STRATA_CONTEXT=32768
# STRATA_MEMORY_GIB=36
# STRATA_RESIDENT_GIB=25
# STRATA_CPUS=6
# STRATA_VRAM_RESERVE_MIB=1536
# STRATA_PORT=8080
# STRATA_GGUF_DIR=/absolute/path/to/matching-shards
# HF_TOKEN=your-token-here

# Set by the launcher for Compose. Normally leave these unset.
# STRATA_RUNTIME_DIR=./strata/runtime
# STRATA_CONFIG=data/offgrid/selected-preset-config.json
# STRATA_UID=1000
# STRATA_GID=1000
