# Data directories - ignore all data directories but keep .gitkeep files
**/data/*
!**/data/.gitkeep

# Llama models - ignore all models but keep .gitkeep
llama/models/*
!llama/models/.gitkeep

# Docker images archive - ignore all except .gitkeep
docker-images/*
!docker-images/.gitkeep

# File server other-files - ignore all except .gitkeep
file-server/other-files/*
!file-server/other-files/.gitkeep

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Log files
*.log

# TheLounge - ignore everything except config.js
thelounge/*
!thelounge/config.js

# InspIRCd - ignore everything except conf/ and logs/ directories
inspircd/*
!inspircd/conf/
!inspircd/logs/
inspircd/conf/*
!inspircd/conf/motd.txt
!inspircd/conf/inspircd.conf
inspircd/logs/*
!inspircd/logs/.gitkeep

